{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "strict": true,
        "declaration": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "types": []
    },
    "include": ["src"]
}

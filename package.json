        "README.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "keywords": [
        "select",
        "select2",
        "tom-select",
        "combobox",
        "dropdown",
        "autocomplete",
        "tagging",
        "multiselect",
        "accessibility",
        "aria",
        "vanilla-js",
        "no-jquery"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OzanKurt/select3.git"
    },
    "homepage": "https://github.com/OzanKurt/select3#readme",

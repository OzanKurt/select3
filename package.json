{
    "name": "@ozankurt/select3",
    "version": "0.2.0",
    "description": "Modern, dependency-free <select> enhancer: single/multi, scoring search, tagging, AJAX and a WAI-ARIA combobox. The successor to Select2 / Tom Select / SumoSelect.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./css": "./src/select3.css",
        "./themes/*": "./src/themes/*.css",
        "./i18n/*": {
            "types": "./dist/i18n/*.d.ts",
            "import": "./dist/i18n/*.js"
        }
    },
    "files": [
        "dist",
        "src/select3.css",
        "src/themes",
        "README.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "keywords": [
        "select",
        "select2",
        "tom-select",
        "combobox",
        "dropdown",
        "autocomplete",
        "tagging",
        "multiselect",
        "accessibility",
        "aria",
        "vanilla-js",
        "no-jquery"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OzanKurt/select3.git"
    },
    "homepage": "https://github.com/OzanKurt/select3#readme",
    "bugs": {
        "url": "https://github.com/OzanKurt/select3/issues"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.5.0",
        "vitest": "^4.0.0",
        "jsdom": "^25.0.0"
    },
    "license": "MIT",
    "author": "Ozan Kurt"
}
